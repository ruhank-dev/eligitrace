# Copy to .env to override defaults (all optional). Never put tokens here —
# Hugging Face auth is handled by `hf auth login` (its own credential store).
ELIGITRACE_TARGET_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ELIGITRACE_DRAFT_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
ELIGITRACE_ADAPTER_REPO_ID=ruhank-dev/eligitrace-qwen2.5-1.5b-lora
ELIGITRACE_DEVICE=auto          # auto | cuda | cpu
ELIGITRACE_DTYPE=float16        # float16 | float32
ELIGITRACE_HOST=127.0.0.1
ELIGITRACE_PORT=8000
